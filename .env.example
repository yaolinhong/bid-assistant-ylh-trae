# Kimi API配置
KIMI_API_KEY=your-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 这个似乎有点慢 不了解其他的模型
KIMI_MODEL=kimi-k2-0905-preview

# Parlant配置
PARLANT_LOG_LEVEL=INFO
PARLANT_SESSION_TIMEOUT=3600

# 数据存储配置
DATA_STORE_PATH=./data
SESSION_CACHE_SIZE=100
PROJECT_CACHE_SIZE=1000

# 网络搜索配置
SEARCH_TIMEOUT=30
SEARCH_MAX_RESULTS=50

# 博查AI API配置
BOCHAAI_API_KEY=your-bochaai-api-key-here

# 应用配置
APP_NAME=招标助手
APP_VERSION=1.0.0
DEBUG=false